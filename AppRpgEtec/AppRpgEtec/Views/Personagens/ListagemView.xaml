<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppRpgEtec.Views.Personagens.ListagemView"
             Title="ListagemView">
    <Shell.TitleView>
        <Button Command="{Binding NovoPersonagemCommand}" Text="Novo" HorizontalOptions="End"></Button>
    </Shell.TitleView>
    
    <ScrollView>
        <VerticalStackLayout Padding="10,0,0,0" VerticalOptions="Fill">

            <CollectionView x:Name="collectionView" ItemsSource="{Binding Personagens}" 
                            VerticalOptions="Fill"
                            SelectionMode="Single"
                            SelectedItem="{Binding PersonagemSelecionado}" >
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItem Text="Remover" IsDestructive="True" 
                                        Command="{Binding BindingContext.RemoverPersonagemCommand,
                                        Source={x:Reference collectionView}}"
                                        CommandParameter="{Binding .}" />
                                </SwipeItems>
                            </SwipeView.RightItems>

                        <Grid Padding="10" RowDefinitions="Auto,Auto">
                            <Label Grid.Row="0" Text="{Binding Nome}" FontSize="18" FontAttributes="Bold" />
                            <Label Grid.Row="1" Text="{Binding PontosVida}" FontSize="14" />

                            <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                Text="🗑"
                BackgroundColor="Transparent"
                TextColor="Red"
                Command="{Binding BindingContext.RemoverPersonagemCommand,
                                  Source={x:Reference collectionView}}"
                CommandParameter="{Binding .}" />
                            </Grid>
                        </SwipeView>                        
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>